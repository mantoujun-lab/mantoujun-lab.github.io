---
import Layout from '../layouts/Layout.astro';
import { Github } from 'simple-icons-astro';
import { Qq } from 'simple-icons-astro';

const navItems = [
  { label: '联系', href: '#contact' },
];
---

<Layout
  title="mantoujun's Lab"
  description="mantoujun's lab — 开源协作实验室"
  navItems={navItems}
>
  <!-- Hero -->
  <section class="hero bg-gradient-to-b from-primary/10 to-base-100 py-20 lg:py-28">
    <div class="hero-content !flex-col !items-center text-center max-w-3xl">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight mb-8">
        mantoujun's lab
      </h1>
      <p class="text-base-content/70 text-lg leading-relaxed mb-10">
        用最小可行方案落地每一个想法
      </p>
      <div class="flex flex-col items-center gap-3">
        <a href="https://github.com/mantoujun-lab" target="_blank" rel="noopener" class="btn btn-outline btn-wide">
          <Github class="size-5" />
          GitHub
        </a>
      </div>
    </div>
  </section>

  <!-- 联系 -->
  <section id="contact" class="py-20 px-4 lg:px-8 bg-base-200/40">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl lg:text-4xl font-bold mb-4">联系</h2>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="https://github.com/orgs/mantoujun-lab/discussions" target="_blank" rel="noopener" class="btn btn-primary"><Github class="size-5" />Github Discussions</a>
        <a href="https://qm.qq.com/q/l5d6VyGD9C" target="_blank" rel="noopener" class="btn btn-primary"><Qq class="size-5" />QQ群</a>
      </div>
    </div>
  </section>
</Layout>
