---
/**
 * 防暗色模式闪烁：尽早把 data-theme 设置到 <html> 上
 * 必须在 <head> 最前面、是同步阻塞的、不能 defer / async
 * 不能做成 Island（Islands 需要客户端 JavaScript 加载）
 *
 * 使用 console.debug：普通用户默认看不到，开发者可在 DevTools 调 Verbose 级查看
 */
---
<script is:inline>
  (function () {
    var stored = localStorage.getItem('theme');
    var prefersDark = matchMedia('(prefers-color-scheme: dark)').matches;
    var t = stored || (prefersDark ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', t);

    console.debug('[ThemeScript] applied:', t, {
      stored: stored,
      prefersDark: prefersDark,
      source: stored ? 'localStorage' : prefersDark ? 'system' : 'default',
    });
  })();
</script>