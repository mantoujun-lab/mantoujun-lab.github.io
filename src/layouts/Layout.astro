---
/**
 * 页面通用布局
 * 抽出 index.astro 与 404.astro 共用的部分：
 * - <head>（meta / favicon / 字体 / logo 预加载 / ThemeScript）
 * - 顶部导航（包含移动端抽屉）
 * - <slot /> 承接页面主体
 * - 底部 footer
 *
 * Props：
 * - title：<title> 文本
 * - description：<meta name="description">
 * - navItems：导航项（默认指向首页锚点）
 * - homeHref：左上角 logo 链接，404 页需指向 '/'
 */
import '../styles/global.css';
import { Menu } from 'lucide-astro';
import ThemeScript from '../components/ThemeScript.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description: string;
  navItems?: { label: string; href: string }[];
  homeHref?: string;
}

const {
  title,
  description,
  navItems = [
    { label: '项目', href: '/#projects' },
    { label: '联系', href: '/#contact' },
  ],
  homeHref = '/',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href="/logo-nobg.webp" />
    <link rel="icon" type="image/png" href="/logo-nobg.png" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/logo.webp" as="image" type="image/webp" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ThemeScript />
  </head>
  <body class="min-h-screen bg-base-100 text-base-content antialiased">
    <div class="drawer drawer-end">
      <input id="nav-drawer" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content flex flex-col">
        <!-- 顶部导航 -->
        <header class="navbar bg-base-100/80 backdrop-blur sticky top-0 z-30 border-b border-base-200 px-4 lg:px-8">
          <div class="flex-1 lg:flex-none lg:mr-auto">
            <a href={homeHref} class="btn btn-ghost px-2 text-xl font-bold tracking-tight">
              <picture>
                <source srcset="/logo.webp" type="image/webp" />
                <img
                  src="/logo.png"
                  alt="mantoujun-lab"
                  width="32"
                  height="32"
                  class="size-8 rounded-lg shadow-sm"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
              <span class="hidden sm:inline">mantoujun's lab</span>
            </a>
          </div>

          <nav class="hidden lg:flex flex-none items-center gap-1">
            {navItems.map((item) => (
              <a href={item.href} class="btn btn-ghost btn-sm">{item.label}</a>
            ))}
          </nav>

          <div class="flex-none gap-2">
            <ThemeToggle />
            <label for="nav-drawer" class="btn btn-ghost btn-circle btn-sm lg:hidden" aria-label="打开菜单">
              <Menu class="size-5" />
            </label>
          </div>
        </header>

        <main class="flex-1">
          <slot />
        </main>

        <footer class="footer footer-center p-8 bg-base-200 text-base-content/60 border-t border-base-200">
          <p class="text-sm">&copy; {new Date().getFullYear()} mantoujun's lab</p>
        </footer>
      </div>

      <!-- 移动端抽屉 -->
      <div class="drawer-side z-40">
        <label for="nav-drawer" class="drawer-overlay" aria-label="关闭菜单"></label>
        <aside class="min-h-full w-72 bg-base-100 border-l border-base-200 p-4">
          <nav class="flex flex-col gap-1">
            {navItems.map((item) => (
              <a href={item.href} class="btn btn-ghost justify-start" data-close-drawer>{item.label}</a>
            ))}
          </nav>
        </aside>
      </div>
    </div>
  </body>
</html>
